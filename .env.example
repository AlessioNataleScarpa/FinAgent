# Google AI Studio API Key
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Gemini Model Selection
GEMINI_MODEL=gemma-4-31b-it

# Set to 1 to use LLM also for presentation/technical/join (slower, richer prose)
PIPELINE_USE_LLM=0

# Local TSFM container (already wired by docker-compose)
TSFM_MODEL_ID=amazon/chronos-bolt-tiny
TSFM_TORCH_THREADS=2
# Optional override: leave empty to use http://tsfm:8081/forecast
TSFM_ENDPOINT=
TSFM_API_TOKEN=
TSFM_TIMEOUT_SECONDS=120
TSFM_HORIZON=240
TSFM_HISTORY_PERIOD=5y

# Optional native LangGraph checkpoints (PostgreSQL on the host)
LANGGRAPH_POSTGRES_URI=
